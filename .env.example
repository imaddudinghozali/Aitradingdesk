# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0-stage0

# Database URL for Supabase
# Format: postgresql://postgres.username:password@db.supabase.co:5432/postgres
# Get your connection string from Supabase dashboard:
# Settings → Database → Connection string → PostgreSQL
# Copy the full connection string and replace USERNAME:PASSWORD
DATABASE_URL=postgresql://postgres.username:password@db.supabase.co:5432/postgres

# Optional: Local PostgreSQL for development
# DATABASE_URL=postgresql://user:password@localhost:5432/imadztrades

# Live Market Data Adapter
# Supported providers: twelvedata, mock
MARKET_DATA_PROVIDER=
TWELVEDATA_API_KEY=
MARKET_INGEST_SYMBOLS=XAUUSD,XAGUSD
MARKET_INGEST_TIMEFRAMES=M5,M15,H1,H4,D
MARKET_INGEST_INTERVAL_SECONDS=300
# Set true to start the scheduler automatically with the FastAPI app
MARKET_INGEST_AUTOSTART=false

# Economic-Calendar Adapter
# Supported providers: trading_economics, mock
CALENDAR_PROVIDER=
TRADING_ECONOMICS_API_KEY=guest:guest
CALENDAR_REFRESH_INTERVAL_SECONDS=3600
CALENDAR_RELEVANT_COUNTRIES=United States
# Override the default keyword list (CPI/PCE/NFP/FOMC/Unemployment/Rate Decision/Powell)
CALENDAR_RELEVANT_EVENTS=
CALENDAR_AUTOSTART=false

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
