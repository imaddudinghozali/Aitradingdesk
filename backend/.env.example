APP_NAME="Imadztrades Shadow AI Trading Desk"
APP_VERSION="0.18.0-backend-complete"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# PostgreSQL / Supabase connection string.
# Local PostgreSQL example:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/imadztrades_ai_desk"
# Supabase example:
# DATABASE_URL="postgresql+psycopg://postgres:[password]@[host]:5432/postgres"
DATABASE_URL=""

# Optional Stage 7 Claude narrative enhancement. Rules mode works without an API key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
ANTHROPIC_API_VERSION="2023-06-01"
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_API_FORMAT="anthropic"
ANTHROPIC_AUTH_SCHEME="x-api-key"

# Optional Stage 7 Telegram output.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_AUTO_SEND_NARRATIVE="false"

# Optional live market ingestion.
# Providers: twelvedata, mock
MARKET_DATA_PROVIDER=""
TWELVEDATA_API_KEY=""
MARKET_INGEST_SYMBOLS="XAUUSD,XAGUSD"
MARKET_INGEST_TIMEFRAMES="M5,M15,H1,H4,D"
MARKET_INGEST_INTERVAL_SECONDS=300
MARKET_INGEST_AUTOSTART=false
MARKET_INGEST_AUTO_ANALYSIS=false
MARKET_INGEST_AUTO_ANALYSIS_TIMEFRAME="M15"
MARKET_INGEST_AUTO_ANALYSIS_PROVIDER="rules"

# Optional economic-calendar ingestion.
# Providers: trading_economics, mock
CALENDAR_PROVIDER=""
TRADING_ECONOMICS_API_KEY=""
CALENDAR_REFRESH_INTERVAL_SECONDS=3600
CALENDAR_RELEVANT_COUNTRIES="United States"
CALENDAR_RELEVANT_EVENTS=""
CALENDAR_AUTOSTART=false
